{
 "doctype": "DocType",
 "name": "Program Outcome",
 "module": "Academics",
 "naming_rule": "Expression",
 "autoname": "format:{program}-{outcome_code}",
 "engine": "InnoDB",
 "field_order": ["program", "outcome_code", "outcome_type", "column_break_1", "regulation", "description"],
 "fields": [
  {"fieldname": "program", "fieldtype": "Link", "options": "Program", "label": "Program", "reqd": 1},
  {"fieldname": "outcome_code", "fieldtype": "Data", "label": "Code (PO1 / PSO1)", "reqd": 1, "in_list_view": 1},
  {"fieldname": "outcome_type", "fieldtype": "Select", "options": "PO\nPSO", "default": "PO", "label": "Type", "reqd": 1, "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "regulation", "fieldtype": "Link", "options": "Regulation", "label": "Regulation", "reqd": 1},
  {"fieldname": "description", "fieldtype": "Small Text", "label": "Statement", "reqd": 1, "in_list_view": 1}
 ],
 "permissions": [
  {"role": "Academics User", "read": 1},
  {"role": "Education Manager", "read": 1, "write": 1, "create": 1}
 ],
 "track_changes": 1
}
